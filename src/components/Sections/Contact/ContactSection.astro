---
/**
 * ContactSection.astro - Sección de Contacto Premium (SkemaIT)
 *
 * Rediseño 2026 — Negro puro:
 *  - Layout editorial 5/7 con macro-whitespace (py-24 → py-32)
 *  - Izquierda: manifiesto + whatsapp direct + trust strip + socials (ContactInfo)
 *  - Derecha: Double-Bezel hardware (outer shell + inner core) con formulario
 *  - Fondo: var(--negro) sólido #0A0A0F, sin orbes ni spotlight
 *  - Motion: GSAP reveal y-16 stagger 0.06, sin magnetismo ni mouse tracking
 *  - A11y: prefers-reduced-motion, contraste ≥4.5:1, focus rings
 */
import ContactForm from "@/components/Sections/Contact/components/form.tsx";
import ContactInfo from "@/components/Sections/Contact/components/ContactInfo.tsx";
---

<section
  id="contact"
  data-contact-section
  class="relative w-full overflow-hidden bg-negro px-6 py-24 text-white md:px-16 md:py-28 lg:py-32"
>


  <div
    class="relative z-[2] mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-14"
  >
    <!-- ══════════ COLUMNA IZQUIERDA: Manifiesto & Contacto ══════════ -->
    <div
      class="flex flex-col lg:col-span-5 lg:sticky lg:top-28"
      data-contact-reveal
    >
      <ContactInfo client:load />
    </div>

    <!-- ══════════ COLUMNA DERECHA: Formulario Double-Bezel ══════════ -->
    <div class="lg:col-span-7" data-contact-reveal>
      <!-- Outer Shell: hardware tray — sutil elevación sobre negro puro -->
      <div
        class="rounded-[2rem] p-1.5 sm:p-2 bg-white/[0.04] ring-1 ring-white/[0.08] shadow-[0_24px_64px_-20px_rgba(0,0,0,0.65)]"
      >
        <!-- Inner Core: tarjeta principal — fondo sólido negro elevado, sin glows -->
        <div
          class="relative overflow-hidden rounded-[calc(2rem-0.5rem)] border border-white/[0.07] bg-[#0F0F13] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)]"
        >

          <div class="relative p-6 sm:p-8 md:p-9">
            <!-- Encabezado de la tarjeta -->
            <div class="flex items-start justify-between gap-4">
              <div class="flex flex-col gap-1.5">
                <span
                  class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.16em] text-white/45"
                >
                  <span class="h-px w-6 bg-white/15"></span>
                  Consulta estratégica
                </span>
                <h3
                  class="text-[1.45rem] sm:text-2xl font-bold tracking-tight text-white leading-none"
                >
                  Envíanos un mensaje
                </h3>
              </div>
              <span
                class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-[#2FE6A6]/20 bg-[#2FE6A6]/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-[#2FE6A6]"
              >
                <span
                  class="size-1.5 rounded-full bg-[#2FE6A6] shadow-[0_0_8px_rgba(47,230,166,0.6)]"
                ></span>
                Respuesta &lt;24h
              </span>
            </div>
            <p
              class="mt-3 text-sm leading-relaxed text-[#C9C4D8]/70 max-w-[46ch] text-pretty"
            >
              Cuéntanos tu proyecto y recibe una propuesta técnica en menos de
              24 horas. Sin compromiso.
            </p>

            <div
              aria-hidden="true"
              class="my-6 h-px bg-[linear-gradient(90deg,transparent_0%,rgba(255,255,255,0.08)_14%,rgba(255,255,255,0.06)_86%,transparent_100%)]"
            >
            </div>

            <!-- Formulario React -->
            <ContactForm client:load />
          </div>
        </div>
      </div>

      <!-- Micro-copy bajo la tarjeta -->
      <p
        class="mt-4 text-center text-[11px] leading-relaxed tracking-wide text-white/30"
      >
        Al enviar aceptas nuestra <a
          href="#"
          class="underline decoration-white/20 underline-offset-4 hover:text-white/60 hover:decoration-white/40 transition-colors"
          >política de privacidad</a
        >. Nunca compartimos tus datos.
      </p>
    </div>
  </div>
</section>

<style is:global>
  [data-contact-reveal] {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-contact-reveal] {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>("[data-contact-section]");
  if (section) {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!prefersReducedMotion) {
      const revealEls = section.querySelectorAll("[data-contact-reveal]");
      if (revealEls.length) {
        gsap.from(revealEls, {
          y: 16,
          autoAlpha: 0,
          duration: 0.7,
          ease: "power3.out",
          stagger: 0.06,
          scrollTrigger: { trigger: section, start: "top 80%", once: true },
        });
      }
      gsap.from("[data-contact-title]", {
        y: 14,
        autoAlpha: 0,
        duration: 0.75,
        ease: "power3.out",
        scrollTrigger: { trigger: section, start: "top 80%", once: true },
      });
    }
  }
</script>
