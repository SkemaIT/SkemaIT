---
/**
 * Footer.astro - Pie de Página Global (SkemaIT)
 *
 * Diseño oscuro moderno alineado al lenguaje visual del sitio (bg-negro, acentos
 * primary/accent, glows ambientales). Incluye:
 * - Marca de agua tipográfica gigante con luz animada (accent ⇄ primary).
 * - Marca + newsletter + columnas de enlaces.
 * - Animaciones de entrada con GSAP + ScrollTrigger (respeta prefers-reduced-motion).
 */

import { Image } from "astro:assets";
import logo from "@/assets/images/LogoPNG/Logo_Principal_Negativo.png";
import Watermark from "@/components/Common/Footer/Watermark";
---

<footer id="main-footer" class="relative overflow-hidden bg-negro text-white">
  <!-- Watermark: ocupa su propio alto en flujo normal -->
  <div
    aria-hidden="true"
    class="relative z-0 text-center leading-none select-none pointer-events-none"
    data-reveal
  >
    <Watermark client:load />
  </div>

  <!-- Contenido del footer: sube con margen negativo para taparlo parcialmente -->
  <div class="relative z-10 bg-background -mt-21">
    <!-- Divisor superior -->
    <div class="border-t border-white/10"></div>

    <div class="max-w-7xl mx-auto px-8 md:px-16">
      <!-- Contenido Principal -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 py-16">
        <!-- Marca -->
        <div class="lg:col-span-4 flex flex-col gap-6" data-reveal>
          <Image src={logo} alt="SkemaIT" width={150} height={30} />
          <p class="text-sm text-[#C9C4D8] leading-relaxed max-w-xs">
            Sistemas de crecimiento & transformación digital para el mercado
            latinoamericano. Tecnología convertida en infraestructura crítica
            para tu negocio.
          </p>
          <!-- Redes sociales -->
          <div class="flex gap-3">
            <a
              href="#"
              aria-label="LinkedIn"
              class="flex size-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-[#C9C4D8] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent active:scale-95"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </a>
            <a
              href="#"
              aria-label="Instagram"
              class="flex size-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-[#C9C4D8] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent active:scale-95"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle>
              </svg>
            </a>
            <a
              href="#"
              aria-label="X (Twitter)"
              class="flex size-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-[#C9C4D8] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent active:scale-95"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
            </a>
            <a
              href="#"
              aria-label="WhatsApp"
              class="flex size-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-[#C9C4D8] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent active:scale-95"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
                ></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Newsletter -->
        <div class="lg:col-span-4 flex flex-col gap-6" data-reveal>
          <span class="text-xs font-bold text-accent tracking-widest uppercase">
            Newsletter
          </span>
          <h3 class="text-2xl font-bold text-white">
            Ideas de crecimiento, cada semana.
          </h3>
          <p class="text-sm text-[#C9C4D8] leading-relaxed">
            Estrategia, diseño y tecnología. Sin spam, solo lo que mueve tu
            negocio.
          </p>
          <form
            id="newsletter-form"
            class="flex flex-col sm:flex-row gap-3"
            novalidate
          >
            <label for="newsletter-email" class="sr-only">
              Correo electrónico
            </label>
            <input
              id="newsletter-email"
              type="email"
              required
              placeholder="tu@empresa.com"
              class="w-full rounded-full border border-white/10 bg-white/5 px-5 py-3.5 text-sm text-white placeholder:text-[#C9C4D8]/60 outline-none transition-colors duration-200 ease-out focus:border-accent/60 focus:ring-2 focus:ring-accent/20"
            />
            <button
              type="submit"
              class="shrink-0 rounded-full bg-accent px-6 py-3.5 text-sm font-bold text-white transition-transform duration-200 ease-out hover:bg-accent/90 active:scale-95"
            >
              SUSCRIBIRME
            </button>
          </form>
          <p
            data-newsletter-msg
            class="hidden text-sm font-semibold text-[#2FE6A6] opacity-0 transition-all duration-300 ease-out"
          >
            ¡Gracias! Revisa tu bandeja de entrada.
          </p>
        </div>

        <!-- Columna: Servicios -->
        <nav
          class="lg:col-span-2 flex flex-col gap-4"
          aria-label="Servicios"
          data-reveal
        >
          <span class="text-xs font-bold text-accent tracking-widest uppercase">
            Servicios
          </span>
          <ul class="flex flex-col gap-3 text-sm">
            <li>
              <a
                href="#"
                class="text-[#C9C4D8] transition-colors duration-200 ease-out hover:text-accent"
                >Desarrollo Web</a
              >
            </li>
            <li>
              <a
                href="#"
                class="text-[#C9C4D8] transition-colors duration-200 ease-out hover:text-accent"
                >Growth Systems</a
              >
            </li>
            <li>
              <a
                href="#"
                class="text-[#C9C4D8] transition-colors duration-200 ease-out hover:text-accent"
                >UX / UI Design</a
              >
            </li>
            <li>
              <a
                href="#"
                class="text-[#C9C4D8] transition-colors duration-200 ease-out hover:text-accent"
                >SEO Técnico</a
              >
            </li>
          </ul>
        </nav>

        <!-- Columna: Empresa -->
        <nav
          class="lg:col-span-2 flex flex-col gap-4"
          aria-label="Empresa"
          data-reveal
        >
          <span class="text-xs font-bold text-accent tracking-widest uppercase">
            Empresa
          </span>
          <ul class="flex flex-col gap-3 text-sm">
            <li>
              <a
                href="#"
                class="text-[#C9C4D8] transition-colors duration-200 ease-out hover:text-accent"
                >Sobre Nosotros</a
              >
            </li>
            <li>
              <a
                href="#"
                class="text-[#C9C4D8] transition-colors duration-200 ease-out hover:text-accent"
                >Casos de Estudio</a
              >
            </li>
            <li>
              <a
                href="#"
                class="text-[#C9C4D8] transition-colors duration-200 ease-out hover:text-accent"
                >Blog</a
              >
            </li>
            <li>
              <a
                href="#"
                class="text-[#C9C4D8] transition-colors duration-200 ease-out hover:text-accent"
                >Contacto</a
              >
            </li>
          </ul>
        </nav>
      </div>

      <!-- Barra Inferior -->
      <div
        class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 py-8 border-t border-white/10"
        data-reveal
      >
        <p class="text-xs text-[#C9C4D8]/70">
          © 2026 SkemaIT. Todos los derechos reservados.
        </p>
        <div class="flex items-center gap-6 text-xs">
          <a
            href="#"
            class="text-[#C9C4D8]/70 transition-colors duration-200 ease-out hover:text-accent"
          >
            Privacidad
          </a>
          <a
            href="#"
            class="text-[#C9C4D8]/70 transition-colors duration-200 ease-out hover:text-accent"
          >
            Términos
          </a>
          <span class="text-[#C9C4D8]/70">
            Hecho con <span class="text-accent">♥</span> en Colombia
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const footer = document.getElementById("main-footer");
  if (footer) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // Entrada escalonada del contenido al llegar al footer
    if (!reduceMotion) {
      ScrollTrigger.create({
        trigger: footer,
        start: "top 80%",
        once: true,
        onEnter: () => {
          gsap.from("[data-reveal]", {
            y: 36,
            autoAlpha: 0,
            duration: 0.9,
            ease: "power3.out",
            stagger: 0.08,
          });
        },
      });
    }

    // Feedback del formulario de newsletter
    const form = footer.querySelector("#newsletter-form");
    const msg = footer.querySelector("[data-newsletter-msg]");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>("input[type='email']");
      if (input && !input.value.trim()) return;
      form.classList.add("hidden");
      if (msg) {
        msg.classList.remove("hidden", "opacity-0");
        msg.classList.add("opacity-100");
      }
    });
  }
</script>
