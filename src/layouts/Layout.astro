---
import "@/styles/global.css";
import "/public/fonts/nunito-otf.css";
import Navbar from "@/components/Common/Navbar/Navbar.astro";
import Footer from "@/components/Common/Footer/Footer.astro";
---

{/* Este archivo contiene el diseño general de la aplicación (skemait.com) */}

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <style>
      body {
        font-family: "Nunito-Regular", sans-serif;
      }
    </style>
    <title>Skemait</title>
  </head>
  <body>
    <Navbar client:load />
    <slot />
    <Footer client:load />
  </body>
</html>
