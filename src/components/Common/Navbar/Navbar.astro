---
import { Image } from "astro:assets";
import logo from "@/assets/images/LogoPNG/Logo_Principal_Negativo.png";
import { Button } from "@/components/ui/button.tsx";
---

<header class="fixed top-0 w-full bg-transparent h-auto z-50">
  <div
    id="navbar-inner"
    class="relative mx-auto flex justify-between items-center p-6"
  >
    <div>
      <Image src={logo} alt="Logo" width={150} height={30} />
    </div>
    <nav class="flex w-auto justify-center">
      <ul class="flex text-white font-normal gap-8">
        <li
          class="relative py-2 cursor-pointer transition-colors duration-300 hover:text-accent group hover:font-bold"
        >
          INICIO
          <span
            class="absolute bottom-0 left-0 w-full h-[2px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
          ></span>
        </li>
        <li
          class="relative py-2 cursor-pointer transition-colors duration-300 hover:text-accent group hover:font-bold"
        >
          SERVICIOS
          <span
            class="absolute bottom-0 left-0 w-full h-[2px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
          ></span>
        </li>
        <li
          class="relative py-2 cursor-pointer transition-colors duration-300 hover:text-accent group hover:font-bold"
        >
          SOBRE NOSOTROS
          <span
            class="absolute bottom-0 left-0 w-full h-[2px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
          ></span>
        </li>
        <li
          class="relative py-2 cursor-pointer transition-colors duration-300 hover:text-accent group hover:font-bold"
        >
          CONTACTO
          <span
            class="absolute bottom-0 left-0 w-full h-[2px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
          ></span>
        </li>
      </ul>
    </nav>
    <Button
      className="rounded-full bg-linear-to-r from-primary via-purple-600 to-accent px-8 py-5 text-white"
    >
      COTIZAR PROYECTO
    </Button>
  </div>
</header>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const bar = document.getElementById("navbar-inner");

  gsap.to(bar, {
    top: "1rem",
    width: "60vw",
    borderRadius: "9999px",
    backgroundColor: "rgba(10, 10, 20, 0.55)",
    backdropFilter: "blur(12px)",
    boxShadow: "0 8px 32px rgba(0, 0, 0, 0.35)",
    ease: "power2.out",
    duration: 0.5,
    scrollTrigger: {
      trigger: document.documentElement,
      start: "top -50",
      end: "max",
      toggleActions: "play none none reverse",
    },
  });
</script>
