# .env.example — Plantilla sin valores reales para SkemaIT
# ⚠️ NUNCA pongas valores reales aquí ni commitees .env
# Copia a .env y pide valores al owner (@jgelv) por canal privado
# Ver docs/ENV_SECURITY.md para flujo completo

# ── Resend (desde servicios@skemait.com) ──
# Usado en src/pages/api/contact.ts:182 — new Resend(import.meta.env.RESEND_API_KEY)
RESEND_API_KEY=

# ── Google Sheets (TablaClientes) ──
# Usado en contact.ts:32,244,247,232
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=TablaClientes
# JSON completo escapado en una línea (service_account)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":""}

# ── Notas ──
# - Si necesitas .env, pídemelo a mí (@jgelv) — nunca lo publiques
# - En Vercel pega cada variable en Project → Settings → Environment Variables
# - Verifica con: git check-ignore -v .env  (debe decir .gitignore:.env)
