---
import { Button } from "@/components/ui/button.tsx";
---

<section class="w-full bg-negro text-white px-8 md:px-16 py-28 relative overflow-hidden border-t border-white/5">
  <!-- Accent glow background -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-96 h-96 bg-primary/10 rounded-full blur-[130px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      
      <!-- Left Column (Sticky heading) -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <span class="text-xs font-bold text-accent tracking-widest uppercase">CAPACIDADES</span>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-white mt-4 mb-6 leading-none text-balance">
          SISTEMAS DISEÑADOS PARA EL <span class="text-accent">IMPACTO</span>
        </h2>
        <p class="text-base text-[#C9C4D8] leading-relaxed mb-8">
          No creamos código aislado. Integramos soluciones tecnológicas que cubren desde la primera impresión interactiva hasta la retención a largo plazo.
        </p>
        <Button className="rounded-full bg-accent px-6 py-6 text-white cursor-pointer hover:bg-accent/90 transition-colors pointer-events-auto">
          VER CASOS DE ESTUDIO
        </Button>
      </div>

      <!-- Right Column (Interactive Services List) -->
      <div class="lg:col-span-7 flex flex-col border-b border-white/10">
        
        <!-- Service 1 -->
        <div class="group py-8 border-t border-white/10 transition-all duration-300 hover:px-4 hover:bg-white/[0.02] cursor-pointer">
          <div class="flex justify-between items-start gap-4">
            <div class="flex gap-6 items-start">
              <span class="text-lg font-bold font-mono text-[#C9C4D8] group-hover:text-accent transition-colors duration-300">01</span>
              <div>
                <h3 class="text-xl md:text-2xl font-bold text-white mb-3 group-hover:text-accent transition-colors duration-300">
                  Desarrollo de Software & WebGL
                </h3>
                <p class="text-sm text-[#C9C4D8] leading-relaxed max-w-xl">
                  Sitios web inmersivos, experiencias 3D personalizadas y aplicaciones web rápidas construidas sobre arquitecturas modernas (Astro, React, Next.js).
                </p>
                <!-- Tags -->
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">React / Astro</span>
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">Three.js / WebGL</span>
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">Performance</span>
                </div>
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#C9C4D8] group-hover:text-accent group-hover:rotate-45 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="group py-8 border-t border-white/10 transition-all duration-300 hover:px-4 hover:bg-white/[0.02] cursor-pointer">
          <div class="flex justify-between items-start gap-4">
            <div class="flex gap-6 items-start">
              <span class="text-lg font-bold font-mono text-[#C9C4D8] group-hover:text-accent transition-colors duration-300">02</span>
              <div>
                <h3 class="text-xl md:text-2xl font-bold text-white mb-3 group-hover:text-accent transition-colors duration-300">
                  Growth Systems & Adquisición
                </h3>
                <p class="text-sm text-[#C9C4D8] leading-relaxed max-w-xl">
                  Embudos de conversión (funnels) optimizados de punta a punta, automatización de marketing y sistemas CRM alineados para generar prospectos calificados.
                </p>
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">Funnels de Venta</span>
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">CRM & Automatización</span>
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">Analytics</span>
                </div>
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#C9C4D8] group-hover:text-accent group-hover:rotate-45 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="group py-8 border-t border-white/10 transition-all duration-300 hover:px-4 hover:bg-white/[0.02] cursor-pointer">
          <div class="flex justify-between items-start gap-4">
            <div class="flex gap-6 items-start">
              <span class="text-lg font-bold font-mono text-[#C9C4D8] group-hover:text-accent transition-colors duration-300">03</span>
              <div>
                <h3 class="text-xl md:text-2xl font-bold text-white mb-3 group-hover:text-accent transition-colors duration-300">
                  Diseño de Marca & UX/UI Premium
                </h3>
                <p class="text-sm text-[#C9C4D8] leading-relaxed max-w-xl">
                  Creación de sistemas de diseño limpios, interfaces intuitivas basadas en psicología del usuario y una identidad de marca coherente con tus metas comerciales.
                </p>
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">UI/UX Design</span>
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">Design Systems</span>
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">Branding</span>
                </div>
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#C9C4D8] group-hover:text-accent group-hover:rotate-45 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </div>

        <!-- Service 4 -->
        <div class="group py-8 border-t border-white/10 transition-all duration-300 hover:px-4 hover:bg-white/[0.02] cursor-pointer">
          <div class="flex justify-between items-start gap-4">
            <div class="flex gap-6 items-start">
              <span class="text-lg font-bold font-mono text-[#C9C4D8] group-hover:text-accent transition-colors duration-300">04</span>
              <div>
                <h3 class="text-xl md:text-2xl font-bold text-white mb-3 group-hover:text-accent transition-colors duration-300">
                  SEO Técnico & Visibilidad Orgánica
                </h3>
                <p class="text-sm text-[#C9C4D8] leading-relaxed max-w-xl">
                  Auditorías técnicas exhaustivas, optimización semántica avanzada y carga veloz enfocada en posicionar tu sitio en los primeros resultados de búsqueda de forma orgánica.
                </p>
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">On-Page SEO</span>
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">Core Web Vitals</span>
                  <span class="text-[11px] bg-white/5 border border-white/10 text-white px-2.5 py-1 rounded-full">Auditoría Técnica</span>
                </div>
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#C9C4D8] group-hover:text-accent group-hover:rotate-45 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>